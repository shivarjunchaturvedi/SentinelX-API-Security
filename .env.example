# SentinelX - Environment Variables Template
# Copy this file to .env and configure secrets accordingly.

# Application Environment
PROJECT_NAME="SentinelX API Security & Threat Intelligence"
ENVIRONMENT="production"
PORT=8000

# Cryptography & Security Secrets (Generate a 32+ character random hex or base64 key)
SECRET_KEY="replace-with-a-secure-random-32-byte-hex-string-for-jwt-signing"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Relational Database Connection URL
# For local SQLite:
DATABASE_URL="sqlite+aiosqlite:///./sentinelx.db"
# For Docker / PostgreSQL production:
# DATABASE_URL="postgresql+asyncpg://sentinel:sentinel_secret@localhost:5432/sentinelx_db"

# Rate Limiting Parameters
ANONYMOUS_RATE_LIMIT_PER_MINUTE=60
AUTHENTICATED_RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_BLOCK_DURATION_SECONDS=120


# Public Application URL
APP_URL="http://localhost:3000"
